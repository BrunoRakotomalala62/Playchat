# Copier vers .env puis ajuster si besoin.

# --- Réseau ---
HOST=127.0.0.1
PORT=8788

# --- Session anonyme plai.chat ---
# Option A (recommandée) : cookie déjà obtenu — ex. exporté d'un navigateur où
# vous avez envoyé un message sur https://plai.chat (cookie HttpOnly
# « web_anon_session », ~2 h de vie). Sans rien mettre, le serveur tente de le
# renouveler tout seul via camoufox-cli (PLAI_AUTO_MINT=1).
#PLAI_COOKIE=web_anon_session=REMPLACEZ_PAR_LA_VALEUR

# Option B : mint automatique via camoufox-cli (résout le Turnstile Cloudflare).
PLAI_AUTO_MINT=true
#PLAI_MINT_CMD=camoufox-cli
#PLAI_MINT_PROXY=http://user:pass@proxy:3128   # optionnel (IP propre requise pour Turnstile)

# --- Comportement ---
PLAI_CONCURRENCY=2          # requêtes upstream simultanées (global)
PLAI_MIN_INTERVAL_MS=700    # pacing entre 2 requêtes partageant un cookie
PLAI_MAX_HISTORY=20         # messages gardés en mémoire par uid
PLAI_LOG_LEVEL=info

# --- Déploiement Vercel (mode serveur Node.js) ---
# Vercel exécute server.js (entrée = script start) et fournit process.env.PORT ;
# PLAI_AUTO_MINT est désactivé par défaut sous Vercel (VERCEL=1). Fournir
# PLAI_COOKIE (cookie exporté d'un navigateur). Rappel : plafond anonyme HORAIRE
# ~40 messages/IP côté plai.chat (429), indépendant du nombre de cookies.
